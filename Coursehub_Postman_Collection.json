								"login"
							]
						},
						"description": "Paso 2 de la prueba de propiedad:\nInicia sesión como Docente B y guarda su token automáticamente."
					},
					"response": []
				},
				{
					"name": "[Paso 3] POST /courses (Crear Curso con Docente A)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res && res.id) {",
									"    pm.collectionVariables.set('course_id', res.id);",
									"    console.log('Curso creado con ID:', res.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token_docente_a}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Curso de Arquitectura Limpia\",\n  \"level\": \"intermediate\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/courses",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"courses"
							]
						},
						"description": "Paso 3 de la prueba de propiedad:\nCrea un curso autenticado como Docente A y guarda su ID en la variable {{course_id}}."
					},
					"response": []
				},
				{
					"name": "[Captura 2] PATCH /courses/:id (Docente A - 200 OK Dueño)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token_docente_a}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Nuevo título actualizado por Docente A\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/courses/{{course_id}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"courses",
								"{{course_id}}"
							]
						},
						"description": "Captura 2 del Punto 5:\nEl Docente A edita su propio curso con éxito (Status 200 OK)."
					},
					"response": []
				},
				{
					"name": "[Captura 3] PATCH /courses/:id (Docente B - 403 Forbidden)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token_docente_b}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Intento de modificación por Docente B\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/courses/{{course_id}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"courses",
								"{{course_id}}"
							]
						},
						"description": "Captura 3 del Punto 5:\nEl Docente B intenta editar el curso del Docente A y el servidor responde 403 Forbidden."
					},
					"response": []
				}
			],
			"description": "Peticiones para el Punto 5: Comprobación de que solo el dueño puede editar su recurso"
		},
