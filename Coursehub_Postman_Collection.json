	"info": {
		"_postman_id": "c1f7a8b9-52d3-4e4b-97e1-8893b1d03f67",
		"name": "Coursehub API - Capturas de Evaluación",
		"description": "Colección lista para importar en Postman y tomar únicamente las capturas solicitadas en la rúbrica.",
