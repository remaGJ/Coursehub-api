	},
	"item": [
		{
			"name": "1. Middleware de registro sin secretos",
			"item": [
				{
					"name": "[Captura 2] POST /auth/login (Login Docente A)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"const token = res.accessToken || res.access_token;",
									"if (token) {",
									"    pm.collectionVariables.set('token_docente_a', token);",
									"    console.log('Token Docente A guardado automáticamente:', token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{docente_a_email}}\",\n  \"password\": \"{{docente_a_password}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Captura 2 del Punto 1:\nEnvía login con email y password. En la consola de Nest se verá el log sin contraseñas ni tokens (Captura 3)."
					},
					"response": []
				}
			],
			"description": "Peticiones para el Punto 1: Middleware de registro"
		},
		{
			"name": "2. Errores consistentes, sin trazas",
			"item": [
				{
					"name": "[Captura 2] GET /courses/99999 (Error 404 Not Found)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/courses/99999",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"courses",
								"99999"
							]
						},
						"description": "Captura 2 del Punto 2:\nDebe devolver 404 con JSON limpio sin trazas ni stack."
					},
					"response": []
				},
				{
					"name": "[Captura 3] POST /courses - Body Inválido (Error 400 Bad Request)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token_docente_a}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"level\": \"intermediate\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/courses",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"courses"
							]
						},
						"description": "Captura 3 del Punto 2:\nEnviamos body sin 'title'. Debe devolver 400 Bad Request con JSON consistente y sin stack trace."
					},
					"response": []
				}
			],
			"description": "Peticiones para el Punto 2: Errores limpios y consistentes"
		},
		{
